rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Strict validation for a single transaction
    function isValidTransaction(t) {
      return t is map 
          && t.id is string && t.id.size() <= 128
          && t.description is string && t.description.size() <= 256
          && t.amount is number
          && t.category is string && t.category.size() <= 64
          && t.paid is bool
          && (t.dueDate == null || (t.dueDate is string && t.dueDate.size() <= 32))
          && (t.paidAt == null || (t.paidAt is string && t.paidAt.size() <= 128))
          && (t.group == null || (t.group is string && t.group.size() <= 128))
          && (t.isSuspended == null || t.isSuspended is bool)
          && (t.updatedAt == null || t.updatedAt is number || t.updatedAt is timestamp);
    }

    // Strict validation for MonthData
    function isValidMonthData(data) {
      return data is map
          && data.keys().hasAll(['incomes', 'expenses', 'updatedAt'])
          && data.keys().size() <= 12
          && (data.updatedAt is timestamp || data.updatedAt is number)
          && data.incomes is list && data.incomes.size() <= 200
          && data.expenses is list && data.expenses.size() <= 200
          && (data.avulsosItems == null || (data.avulsosItems is list && data.avulsosItems.size() <= 200))
          && (data.shoppingItems == null || (data.shoppingItems is list && data.shoppingItems.size() <= 200))
          && (data.goals == null || (data.goals is list && data.goals.size() <= 50))
          && (data.bankAccounts == null || (data.bankAccounts is list && data.bankAccounts.size() <= 20))
          && (data.debtSettlements == null || (data.debtSettlements is list && data.debtSettlements.size() <= 50))
          && (data.bankReserves == null || data.bankReserves is map)
          && (data.checkIn == null || data.checkIn is map);
    }

    // --- Collections ---

    match /families/{familyId}/months/{yearMonth} {
      // 3. Path Variable Hardening
      allow get: if isSignedIn() && isValidId(familyId) && isValidId(yearMonth);
      
      // 8. Secure List Queries
      allow list: if isSignedIn() && isValidId(familyId);

      allow create: if isSignedIn() 
          && isValidId(familyId) 
          && isValidId(yearMonth)
          && isValidMonthData(incoming())
          && (incoming().updatedAt == request.time || incoming().updatedAt == request.time.toMillis());

      allow update: if isSignedIn() 
          && isValidId(familyId) 
          && isValidId(yearMonth)
          && isValidMonthData(incoming())
          && (
            (incoming().updatedAt is timestamp && incoming().updatedAt == request.time)
            || (incoming().updatedAt is number && incoming().updatedAt == request.time.toMillis())
          );
          
      allow delete: if false; // 1. The Invariant: No deletion allowed from client
    }
  }
}
